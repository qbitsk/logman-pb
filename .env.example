# Quote every value: on the self-hosted server this file is read by bash
# (deploy.sh), systemd (EnvironmentFile) and Next.js.
#
# Do NOT set NODE_ENV here. deploy.sh sources this file before `npm ci`, and
# NODE_ENV=production would make npm skip the devDependencies needed to build
# and migrate. The systemd unit sets NODE_ENV=production for runtime.

# ─── Database ────────────────────────────────────────────────
# Self-hosted (local PostgreSQL on the same server):
DATABASE_URL="postgresql://logman:password@127.0.0.1:5432/logman"
# Supabase: use the "Transaction mode" pooled string (port 6543) for the app
# and the "Session mode" string (port 5432) for migrations.
# DATABASE_URL="postgresql://postgres.xxx:password@aws-0-region.pooler.supabase.com:6543/postgres"

# ─── Auth ────────────────────────────────────────────────────
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET="your-secret-here"
# Must be the exact address users open (scheme + host). Switching to https
# later only requires changing this and NEXT_PUBLIC_APP_URL, then rebuilding.
BETTER_AUTH_URL="http://localhost:3000"
# Better Auth log level: debug | info | warn | error (default: info)
LOG_LEVEL="info"

# ─── Email ───────────────────────────────────────────────────
# Get from: https://resend.com/api-keys
RESEND_API_KEY="re_xxxxxxxxxxxx"
EMAIL_FROM="noreply@yourdomain.com"
# Recipient of new-production notifications
ADMIN_EMAIL="admin@yourdomain.com"

# ─── App ─────────────────────────────────────────────────────
# Inlined into the client bundle at build time — changing it requires a rebuild.
NEXT_PUBLIC_APP_URL="http://localhost:3000"
# Self-hosted only: where the proxy reaches the app server itself for session
# checks, bypassing nginx/DNS. Leave unset in dev and on Vercel.
# INTERNAL_APP_URL="http://127.0.0.1:3000"
